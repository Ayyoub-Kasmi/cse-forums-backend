generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activity {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Activity_fk0")

  @@index([user_id], map: "Activity_fk0")
}

model answer {
  thread_id Int
  user_id   Int
  content   String   @db.Text
  date      DateTime @db.Date
  upvotes   Int
  downvotes Int
  thread    thread   @relation(fields: [thread_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Answer_fk0")
  user      user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Answer_fk1")

  @@id([thread_id, user_id])
  @@index([user_id], map: "Answer_fk1")
}

model thread {
  id      Int      @id @default(autoincrement())
  title   String   @db.VarChar(255)
  content String   @db.Text
  date    DateTime @db.Date
  tags    String   @db.VarChar(255)
  user_id Int
  answer  answer[]
  user    user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Thread_fk0")

  @@index([user_id], map: "Thread_fk0")
}

model user {
  id                                  Int              @id @default(autoincrement())
  username                            String           @unique(map: "username") @db.VarChar(255)
  email                               String           @unique(map: "email") @db.VarChar(255)
  password                            String           @db.VarChar(255)
  title                               String           @db.VarChar(255)
  bio                                 String           @db.Text
  creation_date                       DateTime         @db.Date
  facebook_id                         String           @db.VarChar(255)
  instagram_id                        String           @db.VarChar(255)
  github_id                           String           @db.VarChar(255)
  activity                            activity[]
  answer                              answer[]
  favorite_favorite_user_idTouser     favorite[]       @relation("favorite_user_idTouser")
  favorite_favorite_favorite_idTouser favorite[]       @relation("favorite_favorite_idTouser")
  thread                              thread[]
  user_community                      user_community[]
}

model community {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  score          Int              @default(0)
  user_community user_community[]
}

model user_community {
  user_id      Int
  community_id Int
  user         user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_community_fk0")
  community    community @relation(fields: [community_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_community_fk1")

  @@id([user_id, community_id])
  @@index([community_id], map: "user_community_fk1")
}

model favorite {
  user_id                         Int
  favorite_id                     Int
  user_favorite_user_idTouser     user @relation("favorite_user_idTouser", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Favorite_fk0")
  user_favorite_favorite_idTouser user @relation("favorite_favorite_idTouser", fields: [favorite_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Favorite_fk1")

  @@id([user_id, favorite_id])
  @@index([favorite_id], map: "Favorite_fk1")
}
