generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Answer {
  id         Int      @id(map: "Answer_pk") @default(autoincrement())
  thread_id  Int
  user_id    Int
  content    String
  date       DateTime @db.Date
  isApproved Boolean  @default(false)
  Thread     Thread   @relation(fields: [thread_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Answer_fk0")
  User       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Answer_fk1")
  Like       Like[]
  Reply      Reply[]
}

model Like {
  id        Int     @id(map: "Like_pk") @default(autoincrement())
  user_id   Int
  answer_id Int?
  reply_id  Int?
  User      User    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Like_fk0")
  Answer    Answer? @relation(fields: [answer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Like_fk1")
  Reply     Reply?  @relation(fields: [reply_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Like_fk2")
}

model Reply {
  id          Int      @id(map: "Reply_pk") @default(autoincrement())
  answer_id   Int
  user_id     Int
  content     String
  parent_id   Int?
  date        DateTime @db.Date
  Like        Like[]
  Answer      Answer   @relation(fields: [answer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Reply_fk0")
  User        User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Reply_fk1")
  Reply       Reply?   @relation("ReplyToReply", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Reply_fk2")
  other_Reply Reply[]  @relation("ReplyToReply")
}

model Tag {
  id           Int            @id(map: "Tag_pk") @default(autoincrement())
  name         String         @unique @db.VarChar(255)
  threads_tags threads_tags[]
}

model Thread {
  id            Int             @id(map: "Thread_pk") @default(autoincrement())
  title         String          @db.VarChar(255)
  content       String
  date          DateTime        @db.Date
  user_id       Int
  upvotes       Int             @default(0)
  downvotes     Int             @default(0)
  answers_count Int             @default(0)
  Answer        Answer[]
  User          User            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Thread_fk0")
  Vote          Vote[]
  saved_threads saved_threads[]
  threads_tags  threads_tags[]
}

model User {
  id            Int             @id(map: "User_pk") @default(autoincrement())
  username      String          @unique @db.VarChar(255)
  email         String          @unique @db.VarChar(255)
  password      String          @db.VarChar(255)
  title         String          @db.VarChar(255)
  bio           String?
  creation_date DateTime        @db.Date
  facebook_id   String?         @db.VarChar(255)
  instagram_id  String?         @db.VarChar(255)
  github_id     String?         @db.VarChar(255)
  points        Int             @default(0)
  Answer        Answer[]
  Like          Like[]
  Reply         Reply[]
  Thread        Thread[]
  Vote          Vote[]
  saved_threads saved_threads[]
}

model Vote {
  thread_id Int
  user_id   Int
  type      String @db.VarChar(255)
  Thread    Thread @relation(fields: [thread_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Vote_fk0")
  User      User   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Vote_fk1")

  @@id([thread_id, user_id], map: "Vote_pk")
}

model saved_threads {
  thread_id Int
  user_id   Int
  Thread    Thread @relation(fields: [thread_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "saved_threads_fk0")
  User      User   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "saved_threads_fk1")

  @@id([thread_id, user_id], map: "saved_threads_pk")
}

model threads_tags {
  thread_id Int
  tag_id    Int
  Thread    Thread @relation(fields: [thread_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "threads_tags_fk0")
  Tag       Tag    @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "threads_tags_fk1")

  @@id([thread_id, tag_id], map: "threads_tags_pk")
}
